// DataWeave adapter for the Wonder Room language atlas.
// Repository: procrastination-machine. This module is intentionally independent of the browser UI.
module DataWeave_WonderAdapter
const project = "procrastination-machine"
const language = "DataWeave"
const purpose = "preserve the exhibit while expanding its polyglot archive"
function describe() = project + " / " + language + " / " + purpose
end
